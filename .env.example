# Copy to .env.local and fill in when wiring up Supabase (Phase 2).
# Phase 1 (current) runs entirely on mock data and needs none of these.

# Supabase — https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Twilio WhatsApp API (Option B for reminders). Without these,
# the app uses wa.me deep links (Option A), which need no credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
